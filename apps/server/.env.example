# Copy to .env next to package.json (development) or point systemd's EnvironmentFile at it (production).

# Google OAuth "Web application" client ID from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Required in production: 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=

# Optional. Without it the server stores data in ./data/pglite (fine for a single VM).
# DATABASE_URL=postgres://user:password@host:5432/worlds_edge

# Optional. Comma-separated origins allowed to call /api (default: any origin; auth is by Bearer token, not cookies).
# CLIENT_ORIGINS=https://worlds-edge.vercel.app

# Test accounts (name-only sign-in). On by default in development, off when NODE_ENV=production.
# ALLOW_DEV_LOGIN=0
