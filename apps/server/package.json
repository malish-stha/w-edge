{
  "name": "@worlds-edge/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:colyseus --external:@colyseus/* --external:express --external:jose --external:pg --external:@electric-sql/pglite --outfile=dist/index.js --tsconfig=tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.50",
    "@electric-sql/pglite": "^0.6.0",
    "@worlds-edge/shared": "^0.1.0",
    "colyseus": "^0.18.12",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
