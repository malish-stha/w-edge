# systemd unit for the game server on a Linux VM (for example Oracle Cloud's free ARM instance).
# Install: sudo cp deploy/worlds-edge.service /etc/systemd/system/ && sudo systemctl enable --now worlds-edge
# Put GOOGLE_CLIENT_ID and SESSION_SECRET (see apps/server/.env.example) in the EnvironmentFile below.
[Unit]
Description=World's Edge game server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/worlds-edge/apps/server
Environment=NODE_ENV=production
Environment=PORT=2567
EnvironmentFile=/home/ubuntu/worlds-edge/apps/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
